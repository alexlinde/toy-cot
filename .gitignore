# Model files
*.pth
*.pt
*.pkl
*.h5
*.onnx

# Data files
*.csv
*.json
data/
datasets/
# web/ is an app: its JSON is config, lockfiles, and golden test fixtures,
# not data artifacts. Its .onnx bundle stays untracked like *.pth does --
# export_web.py regenerates it from the local checkpoint.
!web/**/*.json

# Logs
*.log
*.jsonl
logs/

# Jupyter Notebook
.ipynb_checkpoints

# PyTorch
*.pth.tar

# Temporary files
*.tmp
*.temp